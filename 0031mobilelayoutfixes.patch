From f3e3947195f73a44589853ecccb1904320325451 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 28 Jul 2026 16:16:35 +0000
Subject: [PATCH] fix: mobile layout bugs in configurator wizard

Three visual bugs from live mobile testing: the loading screen text
("Crafting your proposal...") had no horizontal padding/centering, so
when it wrapped to two lines it ran flush against the screen's left
edge instead of centering under the logo. The final step's "Generate
Private Proposal" button had no horizontal padding, so the longer
Italian translation wrapped to two lines with the text touching the
rounded pill edges. The date picker's month label and check-in/out
dates were hardcoded to en-US formatting, showing "August" instead of
"agosto" on an otherwise fully Italian screen.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XBj5YyCv7itzLP8BDyrEj5
---
 src/app/craft-your-experience/page.tsx | 28 ++++++++++++++++++++------
 1 file changed, 22 insertions(+), 6 deletions(-)

diff --git a/src/app/craft-your-experience/page.tsx b/src/app/craft-your-experience/page.tsx
index a602509..746701e 100644
--- a/src/app/craft-your-experience/page.tsx
+++ b/src/app/craft-your-experience/page.tsx
@@ -1,7 +1,7 @@
 "use client";
 
 import Turnstile from "react-turnstile";
-import { useTranslations } from "next-intl";
+import { useTranslations, useLocale } from "next-intl";
 import { useState, useEffect, useRef } from "react";
 import { useRouter } from "next/navigation";
 import Image from "next/image";
@@ -28,6 +28,14 @@ import {
   trackProposalGenerated,
 } from "@/lib/analytics/gtag";
 
+// Stessa mappa di buildProposalSummary.ts — mese/anno formattati
+// via Intl devono seguire la lingua del sito, non restare in inglese
+// fisso ("August" invece di "agosto").
+const DATE_LOCALES: Record<string, string> = {
+  en: "en-US",
+  it: "it-IT",
