@@ -130,6 +138,8 @@ const TIME_SLOTS: {
 export default function CraftYourExperience() {
 
   const t = useTranslations("configurator");
+  const locale = useLocale();
+  const dateLocale = DATE_LOCALES[locale] ?? "en-US";
   const router = useRouter();
 
   // =======================================================
@@ -381,7 +391,7 @@ export default function CraftYourExperience() {
 
   function formatDisplayDate(iso: string) {
     const [y, m, d] = iso.split("-").map(Number);
-    return new Date(y, m - 1, d).toLocaleDateString("en-US", {
+    return new Date(y, m - 1, d).toLocaleDateString(dateLocale, {
       month: "short",
       day: "numeric",
       year: "numeric",
@@ -1032,7 +1042,7 @@ export default function CraftYourExperience() {
       case "dates": {
 
         const monthLabel = new Date(viewYear, viewMonth, 1).toLocaleDateString(
-          "en-US",
+          dateLocale,
           { month: "long", year: "numeric" }
