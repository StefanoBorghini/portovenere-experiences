       >
 
@@ -1447,7 +1459,7 @@ export default function CraftYourExperience() {
           }}
         />
 
-        <p className="uppercase tracking-[0.35em] text-xs text-zinc-500">
+        <p className="uppercase tracking-[0.35em] text-xs text-zinc-500 max-w-xs">
           {t("loading")}
         </p>
 
@@ -1546,6 +1558,7 @@ export default function CraftYourExperience() {
             className="
               w-1/3
               rounded-full
+              px-2
               py-3.5
               uppercase
               tracking-[0.25em]
@@ -1569,10 +1582,13 @@ export default function CraftYourExperience() {
             className={`
               w-2/3
