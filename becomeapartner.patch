+                  rows={4}
+                  className={inputClass}
+                />
+              </Field>
+
+              <div className="flex justify-center pt-2">
+                <Turnstile
+                  sitekey={process.env.NEXT_PUBLIC_TURNSTILE_SITE_KEY!}
+                  onVerify={(token) => setCaptchaToken(token)}
+                />
+              </div>
+
+              {status === "error" && (
+                <p className="text-center text-red-400 text-sm">{t("form.error")}</p>
+              )}
+
+              <button
+                type="submit"
+                disabled={status === "sending"}
+                className="w-full bg-[#EDEBE7] text-black px-10 py-4 rounded-full uppercase tracking-[0.25em] text-xs hover:scale-[1.02] transition-all duration-500 disabled:opacity-50 disabled:hover:scale-100"
+              >
+                {status === "sending" ? t("form.submitting") : t("form.submit")}
+              </button>
+            </form>
+          )}
+        </div>
+      </section>
+
+      {/* FOOTER */}
+      <footer className="border-t border-[#EDEBE7]/10 py-16 px-6">
+        <div className="max-w-7xl mx-auto flex flex-col items-center gap-8">
+          <img
+            src="/logo-white.png"
+            alt="Portovenere Experiences"
+            className="h-9 w-auto opacity-60"
+          />
+
+          <a
+            href={PRIVACY_URL}
+            target="_blank"
+            rel="noopener noreferrer"
+            className="text-[11px] uppercase tracking-[0.25em] text-zinc-500 hover:text-white transition-colors duration-300"
+          >
+            Privacy
+          </a>
+
+          <p className="text-zinc-700 text-[10px] uppercase tracking-[0.3em]">
+            © {new Date().getFullYear()} Portovenere Experiences
+          </p>
+        </div>
+      </footer>
+    </main>
+  );
+}
+
+const inputClass =
+  "w-full bg-transparent border border-white/15 rounded-2xl px-4 py-3 text-sm text-[#EDEBE7] placeholder:text-zinc-600 focus:outline-none focus:border-white/40 transition-colors duration-300";
+
+function Field({
+  label,
+  required,
+  children,
+}: {
+  label: string;
+  required?: boolean;
+  children: React.ReactNode;
+}) {
+  return (
+    <label className="block">
+      <span className="block text-xs uppercase tracking-[0.15em] text-zinc-400 mb-2">
+        {label}
+        {required && <span className="text-zinc-600"> *</span>}
+      </span>
+      {children}
+    </label>
+  );
+}
