 .../translate-proposal-experiences/route.ts   |  15 +-
 src/lib/translations/translateExperience.ts   | 192 ++++++++++++++++--
 2 files changed, 185 insertions(+), 22 deletions(-)

diff --git a/src/app/api/translate-proposal-experiences/route.ts b/src/app/api/translate-proposal-experiences/route.ts
index e0c4ef7..be0f5d4 100644
--- a/src/app/api/translate-proposal-experiences/route.ts
+++ b/src/app/api/translate-proposal-experiences/route.ts
@@ -125,15 +125,12 @@ export async function POST(request: NextRequest) {
       if (experience?.id) experienceIds.add(experience.id);
     }
 
-    // 2 esperienze alla volta: del tutto sequenziale (com'era prima)
-    // rischiava di superare il maxDuration della funzione quando la
-    // proposal aveva piu' esperienze da tradurre (osservato: solo la
