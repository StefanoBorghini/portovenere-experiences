+                  [&_ul]:list-none
+                  [&_ul]:pl-0
+                  [&_li]:my-2
                   ${
                     !showFullDescription && isDescriptionLong
                       ? "line-clamp-4"
                       : ""
                   }
                 `}
-              >
-
-                {description}
-
