diff --git a/supabase-migrations/2026_experience_animals_allowed.sql b/supabase-migrations/2026_experience_animals_allowed.sql
new file mode 100644
index 0000000..154e378
--- /dev/null
+++ b/supabase-migrations/2026_experience_animals_allowed.sql
@@ -0,0 +1,7 @@
+-- =========================================================
+-- experience_content — "Animals Allowed" (si/no), stesso trattamento
+-- di children_allowed: default true, editabile dalla scheda
+-- esperienza in admin (sezione Filters).
+-- =========================================================
+
+alter table experience_content add column if not exists animals_allowed boolean default true;
diff --git a/supabase-migrations/2026_leads_pets.sql b/supabase-migrations/2026_leads_pets.sql
new file mode 100644
index 0000000..c6e936a
--- /dev/null
+++ b/supabase-migrations/2026_leads_pets.sql
@@ -0,0 +1,8 @@
+-- =========================================================
+-- leads — aggiunge il numero di animali del gruppo (step "guests"
+-- del configuratore), stesso trattamento del campo "children" gia'
+-- esistente: nessuna colonna analoga a traveling_with_children,
+-- 0 significa semplicemente "nessun animale".
+-- =========================================================
+
+alter table leads add column if not exists pets integer default 0;
