From ca0822e3f2987028532c2eb52266cc418bd308bc Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 15 Aug 2026 06:33:02 +0000
Subject: [PATCH] Add pets counter to guests step; Animals Allowed toggle on
 experiences

Configurator guests step: hide the top eyebrow label (redundant with the title), add a pets stepper next to the existing children one, persisted as leads.pets / Proposal.proposal_data.pets. Admin experience editor: new Animals Allowed checkbox (experience_content.animals_allowed, default true) next to Children Allowed; shown in admin leads detail alongside Children.
---
 site_copy_pets.sql                            | 25 ++++++++
 .../[id]/components/FiltersCard.tsx           | 45 ++++++++++++++
 src/app/admin/experiences/[id]/page.tsx       |  3 +
 src/app/admin/leads/[id]/page.tsx             |  4 ++
 src/app/craft-your-experience/page.tsx        | 58 ++++++++++++++++++-
 src/messages/en.json                          |  6 +-
 .../2026_experience_animals_allowed.sql       |  7 +++
 supabase-migrations/2026_leads_pets.sql       |  8 +++
 8 files changed, 152 insertions(+), 4 deletions(-)
 create mode 100644 site_copy_pets.sql
 create mode 100644 supabase-migrations/2026_experience_animals_allowed.sql
 create mode 100644 supabase-migrations/2026_leads_pets.sql

diff --git a/site_copy_pets.sql b/site_copy_pets.sql
new file mode 100644
index 0000000..58ac0a7
--- /dev/null
+++ b/site_copy_pets.sql
@@ -0,0 +1,25 @@
+-- =========================================================
+-- Nuove chiavi per lo stepper "Pets" nello step guests del
+-- configuratore (stesso pattern di children).
+--
+-- src/messages/en.json e' SOLO il seed storico, non letto a runtime:
+-- il testo vive in site_copy / site_copy_translations (Supabase).
+-- =========================================================
+
+insert into site_copy (key, en_text) values
+  ('configurator.guests.petsLabel', 'Pets'),
+  ('configurator.guests.noPets', 'No pets'),
+  ('configurator.guests.onePet', '1 pet'),
+  ('configurator.guests.petsCount', '{count} pets')
+on conflict (key) do update set en_text = excluded.en_text;
+
+insert into site_copy_translations (key, locale, text, translation_status, translated_at, updated_at) values
+  ('configurator.guests.petsLabel', 'it', 'Animali', 'ok', now(), now()),
+  ('configurator.guests.noPets', 'it', 'Nessun animale', 'ok', now(), now()),
+  ('configurator.guests.onePet', 'it', '1 animale', 'ok', now(), now()),
+  ('configurator.guests.petsCount', 'it', '{count} animali', 'ok', now(), now())
+on conflict (key, locale) do update set
+  text = excluded.text,
+  translation_status = excluded.translation_status,
+  translated_at = excluded.translated_at,
+  updated_at = excluded.updated_at;
